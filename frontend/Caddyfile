{
	admin off
}

:80 {
	encode gzip

	handle /api* {
		reverse_proxy backend:8000 {
			flush_interval -1
		}
	}

	handle /assets/* {
		root * /usr/share/caddy
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
	}
}
