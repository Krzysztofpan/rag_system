# Backend
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
APP_ENV=development
# Comma-separated browser origins allowed to call the API.
CORS_ALLOW_ORIGINS=http://localhost:5173

# Supabase — session pooler (port 5432), recommended for FastAPI + SQLModel + Alembic
# Settings → Database → Connection string → Session pooler
DATABASE_PASSWORD=YOUR_PASSWORD
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:${DATABASE_PASSWORD}@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Supabase Auth — Settings → API / API Keys
# Frontend: SUPABASE_URL + SUPABASE_ANON_KEY (vite.config.ts whitelist).
# Backend: SUPABASE_URL for JWKS (ES256 token verification).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Parser (ComplexParser: Docling + OCR repair + guarded LLM repair)
# OPENAI_API_KEY=
# PARSER_LLM_MODEL=gpt-4o-mini
# PARSER_OCR_REPAIR=true
# PARSER_LLM_REPAIR=true
# PARSER_IMAGE_PIPELINE=vlm
# PARSER_VLM_MODEL=gpt-4o-mini
# PARSER_VLM_TIMEOUT=90
# PARSER_VLM_URL=https://api.openai.com/v1/chat/completions
# PARSER_IMAGE_SUFFIXES=[".png",".jpg",".jpeg"]

# Agent conversation memory
# ORCHESTRATOR_MODEL=gpt-4o
# MEMORY_ENABLED=true
# MEMORY_SUMMARIZATION_MODEL=gpt-4o-mini
# MEMORY_COMPACTION_MAX_MESSAGES=12
# MEMORY_COMPACTION_MAX_TOKENS=2500
# MEMORY_KEEP_RECENT_MESSAGES=4
# MEMORY_SUMMARY_MAX_TOKENS=600

# Future phases
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=

# LangSmith observability (LangChain tracing)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGSMITH_PROJECT=rag_system

# Cohere Rerank (trial key is enough for PoC)
COHERE_API_KEY=YOUR_COHERE_API_KEY
COHERE_RERANK_MODEL=rerank-v4.0-fast
RERANK_MIN_SCORE=0.35 